{
    "name": "myjobbot",
    "version": "0.0.0",
    "private": true,
    "license": "GPL-3.0",
    "type": "module",
    "description": "Autonomous agent that finds matching software engineering jobs and emails a digest",
    "engines": {
        "node": ">=24 <25"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/react-dom": "19.3.0",
        "@typescript-eslint/eslint-plugin": "8.71.0",
        "@typescript-eslint/parser": "8.71.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.12.0",
        "happy-dom": "21.0.1",
        "jscpd": "5.4.0",
        "knip": "6.39.0",
        "prettier": "3.9.10",
        "ts-morph": "28.0.0",
        "vite": "8.3.2",
        "vitest": "5.0.3"
    },
    "dependencies": {
        "@types/node": "26.6.4",
        "@types/react": "19.3.0",
        "htmlparser2": "12.0.0",
        "imapflow": "2.3.0",
        "kysely": "0.29.6",
        "mysql2": "3.24.6",
        "next": "16.4.0",
        "openai": "7.27.0",
        "playwright-core": "1.64.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tldts": "7.4.18",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "zod": "4.6.5"
    },
    "scripts": {
        "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/cli.ts",
        "test": "vitest run --project node --project dom",
        "test:db": "vitest run --project integration",
        "typecheck": "tsc --noEmit && NEXT_TELEMETRY_DISABLED=1 next typegen web && tsc --noEmit -p web",
        "check": "npm run typecheck && npm test && habit-hooks",
        "check:db": "npm run test:db",
        "format": "prettier --write .",
        "web": "NEXT_TELEMETRY_DISABLED=1 next dev web --port ${MYJOBBOT_PORT:-8080}",
        "web:build": "NEXT_TELEMETRY_DISABLED=1 next build web",
        "web:start": "NEXT_TELEMETRY_DISABLED=1 next start web --port ${MYJOBBOT_PORT:-8080}",
        "docker:up": "docker compose up -d --build",
        "docker:watch": "docker compose up -d --build && docker compose watch --no-up"
    }
}
