LLM_BASE_URL=http://llm.home.arpa:8081/v1
LLM_MODEL=qwen3-coder-30b
LLM_API_KEY=replace-me
MYJOBBOT_DATA_DIR=data
MYJOBBOT_LOG_DIR=log

# Docker only: when scheduled runs happen (cron syntax) and in which timezone
# SCHEDULE=0 1/8 * * *   (default: every 8 hours from 1 a.m.; e.g. 0 6 * * * for daily at 06:00)
# TZ=America/Los_Angeles       (default)

# Required only when config.json has "searches" (free key at openwebninja.com; subscribe the account to JSearch)
# JSEARCH_API_KEY=

# Web UI (npm run web, Docker web service): the port it listens on and Docker publishes.
# MYJOBBOT_PORT=8080
# Docker web service (required there): every host:port you open the UI with, comma-separated.
# Requests naming any other Host get 421, which stops DNS-rebinding attacks.
# MYJOBBOT_HOSTS=myserver.lan:8080,192.168.1.20:8080

# MariaDB storage (agent, web UI, integration tests). Never commit real values.
# MYJOBBOT_DB_HOST=192.168.3.10
# MYJOBBOT_DB_PORT=3306
# MYJOBBOT_DB_NAME=myjobbot
# MYJOBBOT_DB_USER=myjobbot
# MYJOBBOT_DB_PASSWORD=
# Integration tests only; must end in _test.
# MYJOBBOT_TEST_DB_NAME=myjobbot_test
