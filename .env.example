LLM_BASE_URL=http://llm.home.arpa:8081/v1
LLM_MODEL=qwen3-coder-30b
LLM_API_KEY=replace-me
MYJOBBOT_DATA_DIR=data
MYJOBBOT_LOG_DIR=log

# Docker only: when scheduled runs happen (cron syntax) and in which timezone
# SCHEDULE=0 1/8 * * *   (default: every 8 hours from 1 a.m.; e.g. 0 6 * * * for daily at 06:00)
# TZ=America/Los_Angeles       (default)

# Required only when you save a search on the Settings page (Sources) (free key at openwebninja.com; subscribe the account to JSearch)
# JSEARCH_API_KEY=

# Web UI (npm run web, Docker web service): the port it listens on and Docker publishes.
# MYJOBBOT_PORT=8080
# Docker web service (required there): every host:port you open the UI with, comma-separated.
# Requests naming any other Host get 421, which stops DNS-rebinding attacks.
# MYJOBBOT_HOSTS=myserver.lan:8080,192.168.x.x:8080
# Packaged image only (Helm chart): production serves the web UI built into the image (next start)
# instead of the dev server. Compose leaves it unset.
# MYJOBBOT_WEB_MODE=production

# MariaDB storage (agent, web UI, integration tests). Never commit real values.
# The production deployment uses myjobbot; a local checkout uses its own database and user:
# myjobbot_dev in the main checkout, myjobbot_dev_alt in a second session's worktree.
# MYJOBBOT_DB_HOST=192.168.x.x
# MYJOBBOT_DB_PORT=3306
# MYJOBBOT_DB_NAME=myjobbot_dev
# MYJOBBOT_DB_USER=myjobbot_dev
# MYJOBBOT_DB_PASSWORD=
# Integration tests only: the checkout's test database (myjobbot_test in the main checkout,
# myjobbot_test_alt in a worktree), whose name must hold _test. Each other setting falls
# back to its MYJOBBOT_DB_* one when unset, so a separate test user is optional.
# MYJOBBOT_TEST_DB_HOST=192.168.x.x
# MYJOBBOT_TEST_DB_PORT=3306
# MYJOBBOT_TEST_DB_NAME=myjobbot_test
# MYJOBBOT_TEST_DB_USER=
# MYJOBBOT_TEST_DB_PASSWORD=
# scripts/copy-prod.sh only: a read-only login for the production database (SELECT on myjobbot),
# used to copy it into myjobbot_dev or myjobbot_dev_alt. The copy is written with MYJOBBOT_DB_USER.
# MYJOBBOT_COPY_DB_USER=myjobbot_copy
# MYJOBBOT_COPY_DB_PASSWORD=
# Integration tests only: a Playwright 1.64.1 server for the real-browser test (skipped when unset).
# It must reach the test's own 127.0.0.1 server, so not the compose browser service (README, Develop).
# MYJOBBOT_TEST_BROWSER_URL=ws://127.0.0.1:3001/

# Careers lookup (alert jobs without a description): a SearXNG server answering JSON. Unset = off.
# Your own server, or the bundled one (docker compose --profile search up -d) as http://searxng:8080
# MYJOBBOT_SEARXNG_URL=https://search.example.com
# Bundled SearXNG only: its secret key, any long random string: openssl rand -hex 24
# SEARXNG_SECRET=
# Careers lookup: a Playwright browser service (version 1.64.1, matching playwright-core) for pages
# built by JavaScript. Bundled one: ws://browser:3000/ (docker compose --profile browser up -d browser).
# Unset = no rendering; such pages read as empty.
# MYJOBBOT_BROWSER_URL=ws://browser:3000/

# Seals the Gmail app password stored by the Settings panel. 32 random bytes in base64: openssl rand -base64 32
# Takes effect after recreating the containers (docker compose up -d) or restarting npm run web.
# MYJOBBOT_SECRET_KEY=
