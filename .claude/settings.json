{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/habit-hooks-file.sh",
            "timeout": 120,
            "statusMessage": "habit-hooks: checking file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/habit-hooks-stop.sh",
            "timeout": 300,
            "statusMessage": "habit-hooks: checking project"
          }
        ]
      }
    ]
  }
}
