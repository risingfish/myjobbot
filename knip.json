{
    "entry": ["src/cli.ts!", "src/index.ts!", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx", "tests/**"],
    "project": ["src/**/*.ts!", "src/**/*.tsx!", "web/**/*.{ts,tsx}!"],
    "next": {
        "entry": ["web/next.config.ts", "web/proxy.ts", "web/app/**/{page,layout,not-found,error}.tsx", "web/app/**/route.ts"]
    },
    "ignore": ["dist/**"],
    "ignoreDependencies": ["eslint", "ts-morph", "@typescript-eslint/parser", "@typescript-eslint/eslint-plugin", "jscpd"]
}
