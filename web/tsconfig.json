{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowJs": false,
        "incremental": true,
        "types": ["node"],
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": ["next-env.d.ts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.ts", "**/*.tsx", ".next-test/types/**/*.ts", ".next-test/dev/types/**/*.ts", ".next-docker/types/**/*.ts", ".next-docker/dev/types/**/*.ts"],
    "exclude": ["node_modules"]
}
